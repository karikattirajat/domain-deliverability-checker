# Copy to `.env` in this skill's root directory.
#
# Spamhaus DQS (Data Query Service) key — free tier available.
# Get one at https://www.spamhaus.com/free-trial/sign-up-for-a-free-data-query-service-account/
# With a key set, the skill queries the authenticated *.dq.spamhaus.net zones,
# so Spamhaus ZEN/DBL/ZRD checks work reliably even from cloud or public-resolver
# networks that the public Spamhaus mirrors refuse.
SPAMHAUS_DQS_KEY=

# Invaluement (paid subscription list). Set to 1 ONLY if you have a subscription
# AND run with --resolver pointed at your licensed resolver. Enabling it without
# a subscription produces silent false "clean" results — leave blank otherwise.
INVALUEMENT_ENABLED=

